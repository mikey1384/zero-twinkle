[Unit]
Description=AIZero Scheduler Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/zero
Environment=HOME=/home/ec2-user
Environment=AIZERO_HEARTBEAT_FILE=/tmp/aizero-heartbeat.json
Environment=AIZERO_HEARTBEAT_INTERVAL_SECONDS=15
ExecStart=/usr/bin/env node /home/ec2-user/zero/index.js
Restart=always
RestartSec=5
KillMode=process
TimeoutStopSec=30
# Zero shares a 3.75GiB no-swap host with the API cluster and its workers.
# Measured steady state is ~97MB; the ceilings keep a regression from eating
# the API's rolling-deploy headroom. OOMScoreAdjust sits between the API
# workers (+500) and the optimizer (0): Zero is auto-restarted and watched,
# so the kernel should take it before the primary or the optimizer.
MemoryAccounting=true
MemoryHigh=256M
MemoryMax=384M
MemorySwapMax=0
OOMPolicy=stop
OOMScoreAdjust=300

[Install]
WantedBy=multi-user.target
